POSTGRES_USER=test # insert your username
POSTGRES_PASSWORD=test # insert your user password
POSTGRES_DB=acuity_db
POSTGRES_PORT=5432

PGDATA=/var/lib/postgresql/data/pgdata
# va-security ships a JDBC driver too old to support scram-sha-256 (postgres 17's default)
POSTGRES_HOST_AUTH_METHOD=md5
POSTGRES_INITDB_ARGS=--auth-host=md5
