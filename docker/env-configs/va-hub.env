# POSTGRES_USER: the flyway-provisioned app role, not the postgres.env superuser (see acuity-admin.env)
POSTGRES_USER=acuity
POSTGRES_PASSWORD=test

ENV_TYPE_PROFILE=dev
AUTH_PROFILE=local-no-security
CONFIG_PROFILE=local-config
OTHER_PROFILES=NoScheduledJobs
JAVA_OPTIONS=-Dspring.cloud.config.enabled=false -Dspring.main.allow-bean-definition-overriding=true -Dspring.main.allow-circular-references=true --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
