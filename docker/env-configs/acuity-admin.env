# dedicated app role flyway provisions (V1601908413__setup_users.sql), not the
# postgres superuser in postgres.env - that role's search_path excludes "acuity"
POSTGRES_USER=acuity
POSTGRES_PASSWORD=test

ENV_TYPE_PROFILE=dev
AUTH_PROFILE=local-no-security
CONFIG_PROFILE=local-config
STORAGE_PROFILE=local-storage
