  "scripts": {
    "prestart": "npm run copydefs",
    "start": "ng serve --port 3000 --pc proxy.conf.js",
    "hmr": "ng serve --port 3000 --pc proxy.conf.js --hmr -e=hmr",
    "serve-prod": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng serve -prod --aot=false --port 3000 --pc proxy.conf.js",
    "prebuild": "npm run copydefs",
    "postbuild": "copyfiles -f ./src/error.* dist",
    "build": "ng build --progress=false",
    "dev-build": "ng build",
    "copydefs": "copyfiles -f ../../../../vahub-model/target/*.d.ts  ../../../target/*.d.ts typings",
    "copyindexie": "copyfiles -f ./src/index_ie.* ./src/error.* dist",
    "pretest": "npm run copydefs",
    "test": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng test",
    "test-local": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng test -sr=false --reporters=mocha --browsers Chrome",
    "pretest-jenkins": "npm run copydefs",
    "test-jenkins": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng test -sr=true --reporters=mocha --browsers ChromeHeadless",
    "tslint": "tslint --project tslint.json",
    "prehooks-install": "node config/prehooks-install.js"
  }
