server {
    listen 8000;
    root  /usr/share/nginx/html;
    index index.html;

    # the SPA calls /resources/* on its own origin (see proxy.conf.js in dev)
    location /resources/ {
        # resolve the backend per-request via docker's embedded DNS so nginx
        # still boots when acuity-va-hub isn't up yet
        resolver 127.0.0.11 ipv6=off valid=10s;
        set $vahub_api ${VAHUB_API};
        proxy_pass $vahub_api$request_uri;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
